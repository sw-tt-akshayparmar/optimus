{
  "name": "optimus",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch",
    "test": "ng test",
    "serve:ssr": "node dist/optimus/server/server.mjs",
    "serve:ssr:bun": "bun --hot dist/optimus/server/server.mjs",
    "lint": "eslint . --ext .ts,.html",
    "lint:fix": "eslint . --ext .ts,.html --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,md}\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.1",
    "@angular/common": "^21.2.1",
    "@angular/compiler": "^21.2.1",
    "@angular/core": "^21.2.1",
    "@angular/forms": "^21.2.1",
    "@angular/material": "^21.2.1",
    "@angular/platform-browser": "^21.2.1",
    "@angular/platform-server": "^21.2.1",
    "@angular/router": "^21.2.1",
    "@angular/ssr": "^21.2.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@typescript-eslint/utils": "^8.56.1",
    "animejs": "^4.3.6",
    "compression": "^1.8.1",
    "dexie": "^4.3.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "markdown-it": "^14.1.1",
    "mermaid": "^11.12.3",
    "morgan": "^1.10.1",
    "ngx-socket-io": "^4.10.0",
    "postcss": "^8.5.8",
    "primeicons": "^7.0.0",
    "rxjs": "~7.8.2",
    "sass": "^1.97.3",
    "tailwindcss": "^4.2.1",
    "tslib": "^2.8.1",
    "uuid": "^13.0.0",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.3.0",
    "@angular-eslint/eslint-plugin": "^21.3.0",
    "@angular-eslint/eslint-plugin-template": "^21.3.0",
    "@angular-eslint/template-parser": "^21.3.0",
    "@angular/build": "^21.2.1",
    "@angular/cli": "^21.2.1",
    "@angular/compiler-cli": "^21.2.1",
    "@types/animejs": "^3.1.13",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~6.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.3.5",
    "@typescript-eslint/parser": "^8.56.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jasmine-core": "~6.1.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3"
  }
}
